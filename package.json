{
  "name": "eat-da-burger",
  "version": "2.0.0",
  "description": "Burger tracker rebuilt with React + Express mock API.",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow.bold,cyan.bold \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.mjs",
    "build": "npm run build:client",
    "build:client": "vite build --config client/vite.config.mjs",
    "start": "node server/index.js",
    "test": "npm run test:server && npm run test:client && npm run test:e2e",
    "test:server": "vitest run --config server/vitest.config.mjs",
    "test:client": "vitest run --config client/vite.config.mjs",
    "test:e2e": "vitest run --config client/vite.e2e.config.mjs",
    "lint": "eslint server client --ext .js,.jsx --max-warnings=0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClassyP/burger.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ClassyP/burger/issues"
  },
  "homepage": "https://github.com/ClassyP/burger#readme",
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "supertest": "^7.1.0",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  }
}
